PORT=3000
NODE_ENV=development

# PostgreSQL (required)
# Local Docker: docker compose up -d
DATABASE_URL=postgres://payment:payment@localhost:5436/payment_gateway

# Neon (after `neon deploy` — do not commit real values):
# DATABASE_URL=postgresql://...-pooler.../neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://.../neondb?sslmode=require
# NEON_BRANCH=production

# Integration tests (optional override)
# TEST_DATABASE_URL=postgres://payment:payment@localhost:5436/payment_gateway_test

# Platform admin key (optional) — machine/API access alongside console login
API_KEY=

# Console session signing (defaults to API_KEY or dev fallback)
# CONSOLE_SESSION_SECRET=
# CONSOLE_OWNER_EMAIL=zainnaser18@gmail.com

# SMTP — authorization emails for password changes
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Payment Gateway <you@gmail.com>"

# Legacy global webhook fallback (per-merchant webhook_secret preferred)
WEBHOOK_SECRET=change_me_before_production

# Portfolio / public demo (Fly): visitors get credentials via GET /api/public/demo-console
# PUBLIC_DEMO_MODE=true

PROCESSOR_DELAY_MS=3000
PROCESSOR_SUCCESS_RATE=0.85
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Live FX for filtered transaction volume (USD total)
# Provider: ExchangeRate-API open data feed (no key required)
# FX_API_URL=https://open.er-api.com/v6/latest/USD
# FX_REFRESH_MS=3600000
# FX_FETCH_TIMEOUT_MS=8000
# Optional static override (disables live fetch when set):
# FX_USD_RATES={"EUR":1.08,"GBP":1.27}
# FX_RATES_AS_OF=2026-11-04
